#!/bin/bash
set -e

cd "$(dirname "$(readlink -f "$0")")" || exit 1

VENV_DIR="inventario-persianas/venv"

# Activate the venv if it isn't already active in the current shell
if [ -z "$VIRTUAL_ENV" ]; then
    if [ -f "$VENV_DIR/bin/activate" ]; then
        source "$VENV_DIR/bin/activate"
    else
        echo "Warning: Virtual environment not found at $VENV_DIR"
    fi
fi

# Run the launcher using the active venv Python (or fallback to python3)
if command -v python >/dev/null 2>&1; then
    exec python run_app.py
else
    exec python3 run_app.py
fi

# (cd inventario-persianas/ && uv run src/inventario_persianas/main.py)
