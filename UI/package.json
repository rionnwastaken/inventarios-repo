        "prettier": "^3.7.4",
        "prettier-plugin-jinja-template": "^2.1.0"
    },
    "scripts": {
        "build": "webpack --mode production",
        "watch:webpack": "webpack --watch",
        "copy": "copyfiles -u 1  \"src/**/*.js\" \"src/**/*.css\" static",
        "watch:assets": "chokidar \"src/**/*.html\" --initial -c \"npm run copy\"",
        "tail": "npx tailwindcss -i ./src/css/input.css -o ./static/css/output.css --watch",
        "dev": "concurrently \"npm:watch:webpack\" \"npm:watch:assets\" \"npm:tail\""
    },
    "dependencies": {
        "datatables.net": "^3.0.1",
        "loglevel": "^1.9.2",
        "tom-select":"^2.6.2"
    }
